# Copy to .env and adjust for your machine. Never commit .env.

# Where experiments, datasets, plugins and the SQLite database live.
NEUROKILN_DATA_DIR=./data

# Optional overrides. Defaults live under NEUROKILN_DATA_DIR.
# NEUROKILN_DB=./data/neurokiln.db
# NEUROKILN_AUTH_SECRET_FILE=./data/.auth_secret

# Login token lifetime in seconds (default 12 hours).
# NEUROKILN_TOKEN_TTL=43200

# Number of background experiment/HPO workers (default 1).
# NEUROKILN_JOB_WORKERS=1

# Number of preprocessing artifact caches kept on disk (default 2).
# NEUROKILN_CACHE_ENTRIES=2

# MNE data directory for MOABB datasets.
# NEUROKILN_MNE_DATA=D:/data/mne

# Built frontend directory. The server serves it when present.
# NEUROKILN_WEB_DIST=./web/dist

# Comma-separated origins allowed to call the API from a browser.
# NEUROKILN_CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174

# DANGEROUS: in-process Python plugins have no sandbox. Keep this off unless
# you fully trust every plugin you install.
# NEUROKILN_PLUGIN_TRUST=1
